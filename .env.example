# PostgreSQL connection string
# Intended local target: Docker Compose in docker-compose.yml
# (postgres:16-alpine, user/password/db = thekick, port 5432)
DATABASE_URL=postgresql://thekick:thekick@localhost:5432/thekick

# Auth.js secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
# Full public site URL including protocol. Do not set this to an empty string.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app or your custom domain.
# If AUTH_URL is omitted on Vercel, metadata uses VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@thekick.local
ADMIN_PASSWORD=change-me-to-a-strong-password

# Set to true only in development to insert sample students/grades/permissions
SEED_DEMO=false

# Gmail SMTP for student approval emails (server-side only — never commit real secrets).
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put the 16-character App Password in SMTP_PASS (spaces are OK). Do not use your normal Gmail password.
# SMTP_USER and SMTP_FROM must be that same Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="THE KICK <your-gmail@gmail.com>"

# --- Vercel production ---
# Set these in Project → Settings → Environment Variables (Production + Preview):
# DATABASE_URL          hosted PostgreSQL URL (Neon/Supabase/Railway). Prefer the pooled URL.
# AUTH_SECRET           32+ byte random hex
# AUTH_URL              https://your-project.vercel.app (or custom domain). Full URL, not empty.
# AUTH_TRUST_HOST       true
# ADMIN_EMAIL           used only by `npm run db:seed`
# ADMIN_PASSWORD        used only by `npm run db:seed`
# SEED_DEMO             false
# SMTP_*                required for student approval emails
# Vercel also injects VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically.

# --- Netlify production ---
# Set these in Site configuration → Environment variables (not in git):
# DATABASE_URL          hosted PostgreSQL URL (Neon/Supabase/Railway). Prefer the pooled URL.
# AUTH_SECRET           32+ byte random hex
# AUTH_URL              https://your-site.netlify.app  (or your custom domain, no trailing slash)
# AUTH_TRUST_HOST       true
# ADMIN_EMAIL           used only by `npm run db:seed`
# ADMIN_PASSWORD        used only by `npm run db:seed`
# SEED_DEMO             false
# SMTP_*                required for student approval emails
# NETLIFY is set automatically. News images are stored in PostgreSQL (not the local public/uploads folder).
