# Paste into Coolify → Environment Variables (Production).
# Domain: https://kick.smarterp.space
#
# If you deploy docker-compose.prod.yml, Coolify builds DATABASE_URL from POSTGRES_PASSWORD.
# If you deploy Dockerfile only, set DATABASE_URL to Coolify's Postgres internal URL.

POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgresql://thekick:replace-with-a-long-random-db-password@db:5432/thekick

AUTH_SECRET=replace-with-output-of-node-crypto-randomBytes-32-hex
AUTH_URL=https://kick.smarterp.space
AUTH_TRUST_HOST=true

ADMIN_EMAIL=abdurehmankemal73@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEMO=false
RUN_DB_SEED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abdurehmankemal73@gmail.com
SMTP_PASS=replace-with-gmail-app-password
SMTP_FROM="THE KICK <abdurehmankemal73@gmail.com>"
