# Paste into Coolify → Environment Variables (Production).
# Domain: https://kick.smarterp.space
#
# Coolify Compose file: docker-compose.yml (default). Domain goes on the `app` service.
# DATABASE_URL is built from POSTGRES_PASSWORD (host `db`).

POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgresql://thekick:replace-with-a-long-random-db-password@db:5432/thekick

AUTH_SECRET=replace-with-output-of-node-crypto-randomBytes-32-hex
# Must be the real public URL. Do not leave a placeholder like replace_with_your_coolify_domain.
AUTH_URL=https://kick.smarterp.space
AUTH_TRUST_HOST=true

ADMIN_EMAIL=abdurehmankemal73@gmail.com
# In Coolify's UI, paste the password only — do not include quote characters.
# Those quotes become part of the stored password and sign-in then fails.
# If you use a .env file and the password contains #, quote it there.
ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEMO=false
RUN_DB_SEED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abdurehmankemal73@gmail.com
SMTP_PASS=replace-with-gmail-app-password
SMTP_FROM="THE KICK <abdurehmankemal73@gmail.com>"
